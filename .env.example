# Settings of the Multimedia shop.
#
# Copy this file to `.env.local` on your computer, or enter the same names in
# the hosting's "Environment variables" page. Every value is optional while
# developing: with none of them the site runs in demo mode with an embedded
# database. Never commit a file with real keys.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Products, orders, customers and payments live
# here. Without it the site keeps an embedded database in `.data/`, which is
# fine on your own computer but does not exist on serverless hosting such as
# Vercel: there this value is required, and without it the shop only shows the
# sample products.
# DATABASE_URL=postgres://user:password@host:5432/multimedia

# --- Site -------------------------------------------------------------------
# Public address of the site, without a trailing slash. Payme and Click send
# the customer back to it after paying. Set it on hosting.
# SITE_URL=https://multimedia.uz

# Demo mode stands in for services that are not connected yet: the sign-in code
# is shown on screen instead of an SMS, and Payme and Click are paid on a
# built-in test page. It is on while developing and off on hosting; set it to
# "true" on hosting to try the shop before the real keys arrive. A service
# with real keys below always replaces its demo.
# DEMO_MODE=true

# --- Admin panel ------------------------------------------------------------
# Password of the admin panel, which lives at /uz/admin and /ru/admin. On
# hosting the panel stays closed until this is set, to at least 10 characters.
# Changing it signs every admin browser out. On your own computer, without
# this value, the password is "admin".
# ADMIN_PASSWORD=

# --- Payme (Merchant API) ---------------------------------------------------
# In the Payme cabinet: the endpoint address is
#   https://<site>/api/payments/payme
# and the payment account field is called `order_id`.
# PAYME_MERCHANT_ID=
# The key of the cash desk. For the sandbox use the test key together with
# PAYME_CHECKOUT_URL below; for real payments use the main key and remove it.
# PAYME_KEY=
# PAYME_CHECKOUT_URL=https://test.paycom.uz
# Only when Payme gave you other values than the usual ones:
# PAYME_LOGIN=Paycom
# PAYME_ACCOUNT_FIELD=order_id

# --- Click (SHOP API) -------------------------------------------------------
# In the Click cabinet the two addresses are
#   https://<site>/api/payments/click/prepare
#   https://<site>/api/payments/click/complete
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# Optional, from the same cabinet:
# CLICK_MERCHANT_USER_ID=

# --- SMS sign-in codes (Eskiz.uz) -------------------------------------------
# The texts of the sign-in SMS (see README) must first be approved as
# templates in the Eskiz cabinet.
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# Sender name; 4546 is the shared test sender.
# ESKIZ_FROM=4546
